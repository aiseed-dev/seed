# seed — /etc/systemd/system/seed.service（設計書 §7.4）。API と静的サイトの書き出し
# 置いたら: systemctl daemon-reload && systemctl enable --now seed
# 口は 8010（127.0.0.1 だけ。Caddy から届く）
[Unit]
Description=seed API (seed.aiseed.dev)
After=network-online.target
Wants=network-online.target

[Service]
# 専用の利用者 seed で動かす（作者 11-06「サービスは専用の利用者で動かす」）。AI が動くアカウント dev とは分ける。
# seed が書くのは /var/lib/seed の下だけ。/opt/seed（コード）は dev が置き、seed は読むだけ
User=seed
Group=seed
WorkingDirectory=/opt/seed
# 秘密でない設定だけ（URL、置き場、上限、モデル）。鍵は書かない
EnvironmentFile=/etc/seed/env
# 鍵は root だけが読めるファイル（600 root）。systemd がこのサービスにだけ、$CREDENTIALS_DIRECTORY の下に渡す
# （K-03。環境変数に出さない）。サーバーは在ればそれを読み、無ければ環境変数を読む（server/settings.py）
# 記録（SEED_AUDIT）の署名の鍵。0-1 で必ず作る。LoadCredential= はファイルが無いと起動しない（status=243/CREDENTIALS）
LoadCredential=kagi-log-key:/etc/seed/log-key
# Claude の鍵（/api/read と /api/talk）と Pl@ntNet の鍵（/api/identify）。/etc/credstore/seed.anthropic、
# /etc/credstore/seed.plantnet（root 600）。ImportCredential= は無い物を飛ばすので、鍵が無くてもサービスは起き、
# その口が 503「準備中です」。置いたら systemctl restart seed。systemd 254 から（Debian 13 は 257）
ImportCredential=seed.anthropic
ImportCredential=seed.plantnet
# --no-access-log: /api/lookup は招待コードを query で受けるので、uvicorn の一行のログ（journald）にコードが残る（11-05 に手元で見た）
# uvicorn は 127.0.0.1（Caddy）からの X-Forwarded-For と X-Forwarded-Proto を既定で信じる（返す url が https://seed.aiseed.dev/ になる。11-05 に手元で確かめた）
ExecStart=/opt/seed/.venv/bin/uvicorn seed.server.main:app --host 127.0.0.1 --port 8010 --no-access-log
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
