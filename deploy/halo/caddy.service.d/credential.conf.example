# 形 B: systemd の credential（K-03 の「LoadCredential、systemd-creds encrypt」）。
# 使うなら override.conf の代わりに /etc/systemd/system/caddy.service.d/override.conf としてこの中身を置く
# （形 A と同時に置かない）。手順は deploy/halo/手順.md の c の「形 B」。
#
# 盤の上の token は systemd-creds で暗号化され（TPM があれば TPM に、無ければ /var/lib/systemd/credential.secret に
# 結ばれる。`systemd-creds has-tpm2` で見る）、起動の時だけ復号されて
# /run/credentials/caddy.service/ にこの unit だけが読めるファイルとして置かれる。
#
# Caddyfile はそのまま（{env.HALO_GLIMMER_TOKEN}、{env.HALO_SD_TOKEN}）。起動の時に credential を読んで
# 環境変数にし、exec で caddy に替わる。プロセスの環境には入るが、盤の上の平文のファイルと、
# EnvironmentFile の読み込みが無くなる。
# （Caddy の {file.*} placeholder で直に読む形もあるが、expression の中で使えるかを Claude は確かめていないので採らない。）

[Service]
LoadCredentialEncrypted=halo-glimmer-token:/etc/credstore.encrypted/halo-glimmer-token
LoadCredentialEncrypted=halo-sd-token:/etc/credstore.encrypted/halo-sd-token

ExecStart=
# systemd は ExecStart の中の $ を自分で置き換えるので、sh に渡す $ は $$ と書く。
# 形 A の override.conf と同じく、caddy run に --environ を付けない（token が journal に出る）。
ExecStart=/bin/sh -c 'HALO_GLIMMER_TOKEN="$$(cat "$${CREDENTIALS_DIRECTORY}/halo-glimmer-token")" HALO_SD_TOKEN="$$(cat "$${CREDENTIALS_DIRECTORY}/halo-sd-token")" exec /usr/bin/caddy run --config /etc/caddy/Caddyfile --adapter caddyfile'

ExecReload=
